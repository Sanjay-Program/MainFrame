//GDGUSE     JOB (ACCT),'USE GDG GENERATIONS',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=4M
//STEP1    EXEC PGM=IEFBR14
//GDS0     DD DISP=SHR,DSN=USER.GDG.TEST(0)
//GDS-1    DD DISP=SHR,DSN=USER.GDG.TEST(-1)
//GDS+1    DD DISP=(NEW,CATLG,DELETE),DSN=USER.GDG.TEST(+1),
//             UNIT=SYSDA,SPACE=(TRK,(1,1),RLSE)
//STEP2    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
       DELETE USER.GDG.TEST GENERATIONS
       IF LASTCC = 0 THEN SET MAXCC = 0
/*
