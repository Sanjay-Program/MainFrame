//DDTEST   JOB (ACCT),'DD DISP SPACE TEST',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=4M
//STEP1    EXEC PGM=IEFBR14
//DDNEW    DD DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,VOL=SER=DISK01,
//             DSN=USER.TEST.NEWFILE,SPACE=(TRK,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3200)
//DDOLD    DD DISP=OLD,DSN=USER.TEST.EXISTING
//DDMOD    DD DISP=MOD,DSN=USER.TEST.MODFILE
//DDSHR    DD DISP=SHR,DSN=USER.TEST.SHARED
//DDPASS   DD DISP=(NEW,PASS,DELETE),UNIT=SYSDA,
//             DSN=USER.TEST.PASSFILE,SPACE=(CYL,(1,1),RLSE)
