//DELETEVSAM JOB (ACCT),'DELETE VSAM CLUSTER',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=4M
//STEP1    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
       DELETE USER.VSAM.KSDS CLUSTER PURGE
       DELETE USER.VSAM.ESDS CLUSTER PURGE
       DELETE USER.VSAM.RRDS CLUSTER PURGE
       IF LASTCC = 0 THEN SET MAXCC = 0
/*
