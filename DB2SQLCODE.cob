       IDENTIFICATION DIVISION.
       PROGRAM-ID. DB2SQLCODE.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       EXEC SQL INCLUDE SQLCA END-EXEC.
       EXEC SQL WHENEVER SQLERROR GO TO SQL-ERROR END-EXEC.
       EXEC SQL WHENEVER NOT FOUND GO TO NOT-FOUND END-EXEC.
       01 WS-EMP-ID PIC 9(5) VALUE 99999.
       01 WS-EMP-NAME PIC X(20).

       PROCEDURE DIVISION.
       MAIN-PARA.
           EXEC SQL
               SELECT EMP_NAME INTO :WS-EMP-NAME
               FROM EMPLOYEE WHERE EMP_ID = :WS-EMP-ID
           END-EXEC.
           DISPLAY WS-EMP-NAME.
           STOP RUN.

       NOT-FOUND.
           DISPLAY 'ROW NOT FOUND SQLCODE ' SQLCODE.
           STOP RUN.

       SQL-ERROR.
           DISPLAY 'SQL ERROR SQLCODE ' SQLCODE.
           EXEC SQL ROLLBACK END-EXEC.
           STOP RUN.
