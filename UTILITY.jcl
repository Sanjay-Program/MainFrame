//UTILITY  JOB (ACCT),'IDCAMS UTILITY',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=4M
//STEP1    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
       DELETE USER.TEST.OLDFILE PURGE
       DEFINE CLUSTER (NAME(USER.TEST.VSAM.KSDS) -
               RECORDSIZE(100 100) -
               KEYS(10 0) -
               CYLINDERS(5 5))
       REPRO INFILE(USER.TEST.INPUT) OUTFILE(USER.TEST.VSAM.KSDS)
/*
