//REPROJCL   JOB (ACCT),'VSAM REPRO UTILITY',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=4M
//STEP1    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
       REPRO -
               INFILE(USER.SEQ.INPUT) -
               OUTFILE(USER.VSAM.KSDS)
       IF LASTCC = 0 THEN SET MAXCC = 0
