//CAPSTONE JOB (ACCT),'CAPSTONE BANKING SYSTEM',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=4M
//COBOL    EXEC IGYWCLG
//COBOL.SYSLIB DD DSN=USER.COPYLIB,DISP=SHR
//COBOL.SYSIN DD *
       IDENTIFICATION DIVISION.
       PROGRAM-ID. CAPSTONE.
       PROCEDURE DIVISION.
           DISPLAY 'CAPSTONE BANKING SYSTEM RUNNING'.
           STOP RUN.
