       IDENTIFICATION DIVISION.
       PROGRAM-ID. DB2INSERT.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       EXEC SQL INCLUDE SQLCA END-EXEC.
       01 WS-EMP-ID PIC 9(5) VALUE 50001.
       01 WS-EMP-NAME PIC X(20) VALUE 'NEW EMP'.
       01 WS-DEPT PIC X(10) VALUE 'IT'.
       01 WS-SALARY PIC 9(7)V99 VALUE 6000000.

       PROCEDURE DIVISION.
       MAIN-PARA.
           EXEC SQL
               INSERT INTO EMPLOYEE (EMP_ID, EMP_NAME, DEPT, SALARY)
               VALUES (:WS-EMP-ID, :WS-EMP-NAME, :WS-DEPT, :WS-SALARY)
           END-EXEC.
           IF SQLCODE = 0
               DISPLAY 'INSERT SUCCESSFUL ROWS ' SQLERRD(3)
           ELSE
               DISPLAY 'INSERT FAILED ' SQLCODE
           END-IF.
           EXEC SQL COMMIT END-EXEC.
           STOP RUN.
